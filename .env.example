# ==============================================================================
# Veridon Technologies — Environment Configuration Template
# Instructions: Copy this file to .env and configure with your SMTP credentials.
#   Example: cp .env.example .env
# ==============================================================================

# Application Environment (production / staging / local)
APP_ENV=production
APP_DEBUG=false

# Primary SMTP Server Configuration
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=info@yourdomain.com
SMTP_PASS=your_secure_smtp_password_here
SMTP_SECURE=smtps
SMTP_TIMEOUT=15

# Fallback SMTP Configuration (Port 587 STARTTLS)
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_SECURE=starttls

# Sender Identity
MAIL_FROM_ADDRESS=info@yourdomain.com
MAIL_FROM_NAME="Veridon Notifications"

# Executive Recipients (comma-separated email:Name pairs)
MAIL_RECIPIENTS="info@yourdomain.com:Veridon Info,ceo@yourdomain.com:Veridon CEO,cto@yourdomain.com:Veridon CTO"
